{
  "name": "@open-workflow/host",
  "version": "0.1.0",
  "description": "Self-hostable Node HTTP host for open-workflow: serves the workflow flow/step/webhook endpoints and the 307 dispatch pump, backed by @open-workflow/world-redirect.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "open-workflow-host": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@open-workflow/world-redirect": "workspace:*",
    "@workflow/core": "5.0.0-beta.8",
    "@workflow/world": "5.0.0-beta.5"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
