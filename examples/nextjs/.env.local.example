# Vendor-agnostic backend selection for open-workflow.
WORKFLOW_TARGET_WORLD=@open-workflow/world-redis

# Use a real Redis (self-hosted, ElastiCache, etc.):
WORKFLOW_REDIS_URL=redis://127.0.0.1:6379
# ...or Upstash REST:
# WORKFLOW_REDIS_REST_URL=https://<your>.upstash.io
# WORKFLOW_REDIS_REST_TOKEN=<token>
# ...or zero-setup in-memory (dev only, non-durable):
# WORKFLOW_REDIS_URL=memory

# The dispatcher posts back to this server (the dev server URL).
WORKFLOW_BASE_URL=http://localhost:3000
